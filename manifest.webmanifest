{
  "name": "Suwar",
  "short_name": "Suwar",
  "description": "Fotos und Videos aus der eigenen Nextcloud",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FAFAF8",
  "theme_color": "#FAFAF8",
  "icons": [
    { "src": "icons/stern-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/stern-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/stern-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/stern-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "dateien", "accept": ["image/*", "video/*"] }] }
  }
}
